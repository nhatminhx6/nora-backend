generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum InterestStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum EntityType {
  COMPANY
  STOCK
  CRYPTO
  SPORTS_TEAM
  MOVIE
  PERSON
  TECHNOLOGY
  PRODUCT
  JOB
  TOPIC
  OTHER
}

enum SourceKind {
  PUBLIC_API
  RSS
  WEB_SCRAPING
  OAUTH_CONNECTOR
}

enum SourceStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum EventStatus {
  PENDING
  PROCESSED
  REJECTED
  FAILED
}

enum InsightType {
  SUMMARY
  CLASSIFICATION
  ALERT
  TREND
}

enum UserInsightStatus {
  UNREAD
  READ
  DISMISSED
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum DailyBriefStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum WatchRuleType {
  KEYWORD
  PRICE_ABOVE
  PRICE_BELOW
  PERCENT_CHANGE
  EVENT_MATCH
}

enum WatchRuleStatus {
  ACTIVE
  PAUSED
  DISABLED
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  email             String            @unique @db.VarChar(320)
  passwordHash      String?           @map("password_hash") @db.VarChar(255)
  displayName       String            @map("display_name") @db.VarChar(120)
  timezone          String            @default("UTC") @db.VarChar(64)
  locale            String            @default("en") @db.VarChar(16)
  status            UserStatus        @default(ACTIVE)
  notificationPrefs Json               @default("{}") @map("notification_prefs") @db.JsonB
  profileData       Json               @default("{}") @map("profile_data") @db.JsonB
  lastLoginAt       DateTime?          @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(3)
  devices           Device[]
  refreshTokens     RefreshToken[]
  interests         Interest[]
  userInsights      UserInsight[]
  notifications     Notification[]
  dailyBriefs       DailyBrief[]
  watchRules        WatchRule[]

  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("users")
}

model Device {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  platform         DevicePlatform
  deviceIdentifier String         @map("device_identifier") @db.VarChar(191)
  pushToken        String?        @map("push_token") @db.VarChar(512)
  pushTokenHash    String?        @unique @map("push_token_hash") @db.VarChar(64)
  appVersion       String?        @map("app_version") @db.VarChar(32)
  isActive         Boolean        @default(true) @map("is_active")
  lastSeenAt       DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens    RefreshToken[]

  @@unique([userId, deviceIdentifier])
  @@index([userId, isActive])
  @@map("devices")
}

model RefreshToken {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  deviceId          String?        @map("device_id") @db.Uuid
  familyId          String         @map("family_id") @db.Uuid
  tokenHash         String         @unique @map("token_hash") @db.VarChar(255)
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt            DateTime?      @map("used_at") @db.Timestamptz(3)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revokeReason      String?        @map("revoke_reason") @db.VarChar(64)
  replacedByTokenId String?        @unique @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device            Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  replacedByToken   RefreshToken?  @relation("TokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacesToken     RefreshToken?  @relation("TokenRotation")

  @@index([userId, familyId])
  @@index([userId, expiresAt])
  @@index([deviceId, revokedAt])
  @@map("refresh_tokens")
}

model Interest {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  name            String           @db.VarChar(160)
  normalizedName  String           @map("normalized_name") @db.VarChar(160)
  description     String?          @db.Text
  type            EntityType
  status          InterestStatus   @default(ACTIVE)
  config          Json             @default("{}") @db.JsonB
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(3)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  interestEntities InterestEntity[]
  userInsights    UserInsight[]
  watchRules      WatchRule[]

  @@unique([userId, normalizedName])
  @@index([userId, status])
  @@index([type, status])
  @@map("interests")
}

model Entity {
  id                  String               @id @default(uuid()) @db.Uuid
  type                EntityType
  canonicalName       String               @map("canonical_name") @db.VarChar(200)
  normalizedName      String               @map("normalized_name") @db.VarChar(200)
  canonicalKey        String               @map("canonical_key") @db.VarChar(255)
  description         String?              @db.Text
  canonicalUrl        String?              @map("canonical_url") @db.Text
  aliases             String[]             @default([])
  metadata            Json                 @default("{}") @db.JsonB
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  interestEntities    InterestEntity[]
  sourceSubscriptions SourceSubscription[]
  eventEntities       EventEntity[]
  insightEntities     InsightEntity[]
  watchRules          WatchRule[]

  @@unique([type, canonicalKey])
  @@index([type, normalizedName])
  @@map("entities")
}

model InterestEntity {
  interestId String   @map("interest_id") @db.Uuid
  entityId   String   @map("entity_id") @db.Uuid
  confidence Decimal  @db.Decimal(5, 4)
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([interestId, entityId])
  @@index([entityId, interestId])
  @@map("interest_entities")
}

model Source {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(120)
  slug                String               @unique @db.VarChar(120)
  kind                SourceKind
  adapterKey          String               @map("adapter_key") @db.VarChar(120)
  baseUrl             String?              @map("base_url") @db.Text
  status              SourceStatus         @default(ACTIVE)
  config              Json                 @default("{}") @db.JsonB
  credentialsRef      String?              @map("credentials_ref") @db.VarChar(255)
  defaultIntervalSec  Int                  @map("default_interval_sec")
  rateLimitPerMinute  Int?                 @map("rate_limit_per_minute")
  lastSyncedAt        DateTime?            @map("last_synced_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscriptions       SourceSubscription[]
  events              Event[]

  @@index([status, kind])
  @@index([adapterKey])
  @@map("sources")
}

model SourceSubscription {
  id                  String             @id @default(uuid()) @db.Uuid
  sourceId            String             @map("source_id") @db.Uuid
  entityId            String?            @map("entity_id") @db.Uuid
  subscriptionKey     String             @map("subscription_key") @db.VarChar(255)
  externalReference   String?            @map("external_reference") @db.VarChar(255)
  status              SubscriptionStatus @default(ACTIVE)
  config              Json               @default("{}") @db.JsonB
  cursor              String?            @db.Text
  nextSyncAt          DateTime           @map("next_sync_at") @db.Timestamptz(3)
  lastSyncAt          DateTime?          @map("last_sync_at") @db.Timestamptz(3)
  lastSuccessAt       DateTime?          @map("last_success_at") @db.Timestamptz(3)
  consecutiveFailures Int                @default(0) @map("consecutive_failures")
  lastErrorCode       String?            @map("last_error_code") @db.VarChar(64)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  source              Source             @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  entity              Entity?            @relation(fields: [entityId], references: [id], onDelete: SetNull)
  events              Event[]

  @@unique([sourceId, subscriptionKey])
  @@index([status, nextSyncAt])
  @@index([entityId, status])
  @@map("source_subscriptions")
}

model Event {
  id                   String              @id @default(uuid()) @db.Uuid
  sourceId             String              @map("source_id") @db.Uuid
  sourceSubscriptionId String?             @map("source_subscription_id") @db.Uuid
  externalId           String              @map("external_id") @db.VarChar(512)
  contentHash          String              @map("content_hash") @db.VarChar(64)
  type                 String              @db.VarChar(80)
  title                String              @db.Text
  content              String              @db.Text
  summary              String?             @db.Text
  url                  String?             @db.Text
  author               String?             @db.VarChar(255)
  language             String?             @db.VarChar(16)
  publishedAt          DateTime            @map("published_at") @db.Timestamptz(3)
  occurredAt           DateTime?           @map("occurred_at") @db.Timestamptz(3)
  status               EventStatus         @default(PENDING)
  metadata             Json                @default("{}") @db.JsonB
  ingestedAt           DateTime            @default(now()) @map("ingested_at") @db.Timestamptz(3)
  processedAt          DateTime?           @map("processed_at") @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  source               Source              @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceSubscription   SourceSubscription? @relation(fields: [sourceSubscriptionId], references: [id], onDelete: SetNull)
  eventEntities        EventEntity[]
  insightEvents        InsightEvent[]

  @@unique([sourceId, externalId])
  @@index([contentHash])
  @@index([status, ingestedAt])
  @@index([publishedAt(sort: Desc)])
  @@index([sourceSubscriptionId, publishedAt(sort: Desc)])
  @@map("events")
}

model EventEntity {
  eventId        String   @map("event_id") @db.Uuid
  entityId       String   @map("entity_id") @db.Uuid
  relevanceScore Decimal  @map("relevance_score") @db.Decimal(5, 4)
  mentionCount   Int      @default(1) @map("mention_count")
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entity         Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([eventId, entityId])
  @@index([entityId, eventId])
  @@map("event_entities")
}

model Insight {
  id              String          @id @default(uuid()) @db.Uuid
  type            InsightType
  title           String          @db.Text
  content         String          @db.Text
  language        String?         @db.VarChar(16)
  importanceScore Decimal         @map("importance_score") @db.Decimal(5, 4)
  confidenceScore Decimal?        @map("confidence_score") @db.Decimal(5, 4)
  modelProvider   String?         @map("model_provider") @db.VarChar(64)
  modelName       String?         @map("model_name") @db.VarChar(120)
  promptVersion   String?         @map("prompt_version") @db.VarChar(32)
  metadata        Json            @default("{}") @db.JsonB
  generatedAt     DateTime        @default(now()) @map("generated_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  insightEvents   InsightEvent[]
  insightEntities InsightEntity[]
  userInsights    UserInsight[]

  @@index([type, generatedAt(sort: Desc)])
  @@map("insights")
}

model InsightEvent {
  insightId String   @map("insight_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  insight   Insight  @relation(fields: [insightId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([insightId, eventId])
  @@index([eventId, insightId])
  @@map("insight_events")
}

model InsightEntity {
  insightId     String   @map("insight_id") @db.Uuid
  entityId      String   @map("entity_id") @db.Uuid
  relevanceScore Decimal @map("relevance_score") @db.Decimal(5, 4)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  insight       Insight  @relation(fields: [insightId], references: [id], onDelete: Cascade)
  entity        Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([insightId, entityId])
  @@index([entityId, insightId])
  @@map("insight_entities")
}

model UserInsight {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  insightId     String            @map("insight_id") @db.Uuid
  interestId    String?           @map("interest_id") @db.Uuid
  status        UserInsightStatus @default(UNREAD)
  relevanceScore Decimal          @map("relevance_score") @db.Decimal(5, 4)
  matchedReason Json              @default("{}") @map("matched_reason") @db.JsonB
  seenAt        DateTime?         @map("seen_at") @db.Timestamptz(3)
  readAt        DateTime?         @map("read_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  insight       Insight           @relation(fields: [insightId], references: [id], onDelete: Cascade)
  interest      Interest?         @relation(fields: [interestId], references: [id], onDelete: SetNull)
  notifications Notification[]
  dailyBriefItems DailyBriefItem[]

  @@unique([userId, insightId, interestId])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([interestId, createdAt(sort: Desc)])
  @@map("user_insights")
}

model WatchRule {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  interestId      String?         @map("interest_id") @db.Uuid
  entityId        String?         @map("entity_id") @db.Uuid
  name            String          @db.VarChar(160)
  type            WatchRuleType
  status          WatchRuleStatus @default(ACTIVE)
  conditions      Json            @db.JsonB
  cooldownSeconds Int             @default(3600) @map("cooldown_seconds")
  lastTriggeredAt DateTime?       @map("last_triggered_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(3)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest        Interest?       @relation(fields: [interestId], references: [id], onDelete: SetNull)
  entity          Entity?         @relation(fields: [entityId], references: [id], onDelete: SetNull)
  notifications   Notification[]

  @@index([userId, status])
  @@index([interestId, status])
  @@index([entityId, status])
  @@map("watch_rules")
}

model Notification {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  userInsightId      String?             @map("user_insight_id") @db.Uuid
  watchRuleId        String?             @map("watch_rule_id") @db.Uuid
  channel            NotificationChannel
  status             NotificationStatus  @default(PENDING)
  title              String              @db.VarChar(255)
  body               String              @db.Text
  actionUrl          String?             @map("action_url") @db.Text
  deduplicationKey   String              @map("deduplication_key") @db.VarChar(255)
  scheduledAt        DateTime            @map("scheduled_at") @db.Timestamptz(3)
  sentAt             DateTime?           @map("sent_at") @db.Timestamptz(3)
  failedAt           DateTime?           @map("failed_at") @db.Timestamptz(3)
  attemptCount       Int                 @default(0) @map("attempt_count")
  providerMessageId  String?             @map("provider_message_id") @db.VarChar(255)
  lastErrorCode      String?             @map("last_error_code") @db.VarChar(64)
  metadata           Json                @default("{}") @db.JsonB
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userInsight        UserInsight?        @relation(fields: [userInsightId], references: [id], onDelete: SetNull)
  watchRule          WatchRule?          @relation(fields: [watchRuleId], references: [id], onDelete: SetNull)

  @@unique([userId, channel, deduplicationKey])
  @@index([status, scheduledAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model DailyBrief {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  briefDate    DateTime         @map("brief_date") @db.Date
  timezone     String           @db.VarChar(64)
  status       DailyBriefStatus @default(PENDING)
  title        String           @db.VarChar(255)
  summary      String?          @db.Text
  generatedAt  DateTime?        @map("generated_at") @db.Timestamptz(3)
  failureCode  String?          @map("failure_code") @db.VarChar(64)
  metadata     Json             @default("{}") @db.JsonB
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        DailyBriefItem[]

  @@unique([userId, briefDate])
  @@index([userId, briefDate(sort: Desc)])
  @@index([status, briefDate])
  @@map("daily_briefs")
}

model DailyBriefItem {
  id            String       @id @default(uuid()) @db.Uuid
  dailyBriefId  String       @map("daily_brief_id") @db.Uuid
  userInsightId String?      @map("user_insight_id") @db.Uuid
  position      Int
  section       String       @db.VarChar(80)
  title         String       @db.Text
  content       String       @db.Text
  actionUrl     String?      @map("action_url") @db.Text
  metadata      Json         @default("{}") @db.JsonB
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  dailyBrief    DailyBrief   @relation(fields: [dailyBriefId], references: [id], onDelete: Cascade)
  userInsight   UserInsight? @relation(fields: [userInsightId], references: [id], onDelete: SetNull)

  @@unique([dailyBriefId, position])
  @@unique([dailyBriefId, userInsightId])
  @@map("daily_brief_items")
}
