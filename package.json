{
  "name": "nora-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Nora AI personal assistant backend",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "nest build api && nest build worker && nest build scheduler",
    "build:api": "nest build api",
    "build:worker": "nest build worker",
    "build:scheduler": "nest build scheduler",
    "start:api": "nest start api --watch",
    "start:worker": "nest start worker --watch",
    "start:scheduler": "nest start scheduler --watch",
    "start:prod:api": "node dist/apps/api/src/main.js",
    "start:prod:worker": "node dist/apps/worker/src/main.js",
    "start:prod:scheduler": "node dist/apps/scheduler/src/main.js",
    "typecheck": "tsc --noEmit",
    "test:prepare-data": "node --test --require ts-node/register --require tsconfig-paths/register packages/modules/ingestion/test/*.test.ts",
    "test:content-contracts": "node --test --require ts-node/register packages/common/test/*.test.ts",
    "test:feed-v2": "node --test --require ts-node/register --require tsconfig-paths/register packages/modules/content/test/*.test.ts",
    "test:work-items": "node --test --require ts-node/register packages/modules/work-items/test/*.test.ts",
    "test:postman": "node scripts/validate-postman-collection.mjs",
    "test:content-acceptance": "npm run test:prepare-data && npm run test:feed-v2 && npm run test:content-contracts",
    "format": "prettier --write \"{apps,packages}/**/*.ts\" \"*.{json,yml}\"",
    "prisma:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema packages/database/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema packages/database/prisma/schema.prisma",
    "prisma:seed": "ts-node packages/database/prisma/seed.ts",
    "seed:data": "npm run prisma:seed",
    "terminology": "ts-node --require tsconfig-paths/register packages/modules/ingestion/scripts/terminology-glossary.ts",
    "content:backfill": "ts-node --require tsconfig-paths/register packages/modules/ingestion/scripts/content-backfill.ts",
    "content:replay": "ts-node --require tsconfig-paths/register packages/modules/ingestion/scripts/content-replay.ts",
    "content:dlq": "ts-node --require tsconfig-paths/register packages/modules/ingestion/scripts/content-dlq.ts",
    "content:load-test": "ts-node --require tsconfig-paths/register packages/modules/ingestion/scripts/content-load-test.ts",
    "content:shadow-report": "ts-node --require tsconfig-paths/register packages/modules/ingestion/scripts/content-shadow-report.ts",
    "content:rollout": "ts-node --require tsconfig-paths/register packages/modules/ingestion/scripts/content-rollout.ts",
    "content:prepare-topics": "ts-node --require tsconfig-paths/register packages/modules/interests/scripts/prepare-content-topics.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.58.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "fast-xml-parser": "^5.10.1",
    "ioredis": "^5.7.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.0",
    "@types/node": "^22.15.0",
    "@types/passport-jwt": "^4.0.1",
    "prettier": "^3.6.2",
    "prisma": "^6.14.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
